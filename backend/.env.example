# Copy to .env and adjust for your environment.
# Defaults below run the whole app with zero external infrastructure.

APP_NAME=Job Application Strategy AI
ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Set to false to use real MongoDB + Redis (see docker-compose.yml)
DEMO_MODE=true
SEED_DEMO_DATA=true

MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=job_strategy_ai

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=1800
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# local_tfidf requires no credentials. Set to vertex_ai / openai in production
# and implement the corresponding provider in app/services/embeddings.py
EMBEDDING_PROVIDER=local_tfidf
LLM_PROVIDER=local_template
EMBEDDING_DIM=128
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GCP_PROJECT_ID=

W_INTENT=0.20
W_SEMANTIC=0.25
W_SKILL=0.25
W_EXPERIENCE=0.12
W_EDUCATION=0.08
W_LOCATION=0.10

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:3000"]
